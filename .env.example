# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so never
# put a real key here.
#
#   cp .env.example .env
#
# Everything below is optional. With an empty `.env` the app still boots, the
# voice sandbox works, and the generated panoramas are all there — only the two
# features that call somebody else's paid API go quiet.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Google Maps — the Street View backdrop
#
# Read by:  src/core/App.js  (as import.meta.env.VITE_GOOGLE_MAPS_KEY)
# Used by:  ?streetview
#
# The VITE_ prefix is required. Vite only exposes variables with it to browser
# code, and this one has to reach the browser because the Maps JavaScript API is
# loaded there.
#
# Which API: enable **Maps JavaScript API** on the key. Not Street View Static
# API — that one serves image bytes, and the terms forbid storing or caching
# them, which is exactly why this project uses the live viewer instead.
#
# Billing must be on, or the viewer loads and then refuses.
#
# Restrictions: an HTTP-referrer restriction is the right setting for a browser
# key, but a temporary tunnel domain changes on every restart, so a key locked
# to yesterday's URL silently fails. Either add the current domain each time or
# leave it unrestricted only while testing — an unrestricted public key is
# anybody's to spend.
#
# Also settable per-visit without a rebuild:  ?gmapskey=YOUR_KEY
# ---------------------------------------------------------------------------
VITE_GOOGLE_MAPS_KEY=


# ---------------------------------------------------------------------------
# Image generation — panorama backdrops
#
# Read by:  tools/generate-panorama.mjs
#
#   node tools/generate-panorama.mjs raw.jpg "a prompt"
#   node tools/process-panorama.mjs raw.jpg public/hdri/name [eyeHeight] [ringMetres]
#
# Only needed to generate *new* panoramas. The ones already in public/hdri/ work
# without any of this.
#
# The script talks to Gemini's generateContent endpoint and reads the key from
# this file directly — it does not go through process.env, so no VITE_ prefix
# and no shell export.
# ---------------------------------------------------------------------------

# Informational only: nothing reads this. Kept because the base URL and the
# request shape are provider-specific, and the next person should know which
# one these values are for.
IMAGE_GEN_PROVIDER=google-native

IMAGE_GEN_BASE_URL=https://generativelanguage.googleapis.com/v1beta
IMAGE_GEN_MODEL=gemini-3.1-flash-image
IMAGE_GEN_API_KEY=


# ---------------------------------------------------------------------------
# Tooling
#
# Read by:  tools/process-panorama.mjs  (as process.env.PUPPETEER_FROM)
#
# That script needs Puppeteer purely as a JPEG decoder and resampler — the
# model cannot emit a 2:1 image, so one gets drawn to a canvas at 4096x2048.
# Set this only if Puppeteer is installed somewhere other than this project,
# and note it is an environment variable rather than a line this file supplies:
#
#   PUPPETEER_FROM=/path/to/dir/ node tools/process-panorama.mjs ...
#
# Left unset, the script resolves Puppeteer from the current directory.
# ---------------------------------------------------------------------------
# PUPPETEER_FROM=
